# ============================================================
# MySQL 自定义配置
# 挂载路径：/etc/mysql/conf.d/my.cnf
# ============================================================

[mysqld]
# 字符集：与业务库 utf8mb4 一致
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# 允许较大的包（上传 / 批量 SQL）
max_allowed_packet = 64M

# 时区
default-time-zone = '+08:00'

# 忽略大小写（可选，便于跨环境兼容）
lower_case_table_names = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
