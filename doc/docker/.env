# ============================================================
# Bedrock Cloud Docker Compose 环境变量
# 可按部署环境修改；敏感信息生产环境请务必更换
# ============================================================

# ---------- MySQL ----------
# root 密码（需与 Nacos 配置中 spring.datasource.password 一致）
MYSQL_ROOT_PASSWORD=root
# 首次初始化时创建的数据库名
MYSQL_DATABASE=bedrock

# ---------- Redis ----------
# 密码在 redis/conf/redis.conf 的 requirepass 中配置，默认 123456

# ---------- Nacos 3.x 鉴权（开发默认值，生产请更换） ----------
# Token 需为 Base64 编码且原始长度 >= 32
NACOS_AUTH_TOKEN=FAKESECRET_y1z2a3b4c5d6e7f8g9h0=
# 服务端身份标识 key / value
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# ---------- 业务应用 ----------
# Spring 激活环境（dev / test / prod），对应 BedrockApplication.getProfile
SPRING_PROFILES_ACTIVE=dev
# 容器内 Nacos 地址；Java 读取 NACOS_ADDRESS（勿再用 NACOS_ADDR）
NACOS_ADDRESS=nacos:8848
# Nacos 登录账号 / 密码 / 命名空间（覆盖 NacosConstant 代码默认值）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=790c0609-a49f-4fef-b56b-88788f7292bb
# Sentinel 控制台地址与日志目录（compose 未含 Sentinel 时可按部署环境改）
SENTINEL_ADDRESS=127.0.0.1:7080
SENTINEL_LOG_DIR=/home/bedrock/logs/csp/
# 默认 JVM 参数
JAVA_OPTS=-Xms512m -Xmx512m
