<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.bedrock.ai.mapper.AiMcpMapper">
    <resultMap id="AiMcpDetailMap" type="org.bedrock.ai.vo.AiMcpDetailVO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="url" column="url"/>
        <result property="endpoint" column="endpoint"/>
        <result property="headers" column="headers"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="stdioServersJson" column="stdio_servers_json"/>
        <result property="clientName" column="client_name"/>
        <result property="version" column="version"/>
        <result property="requestTimeoutSeconds" column="request_timeout_seconds"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectDetailById" resultMap="AiMcpDetailMap">
        SELECT id,
               name,
               type,
               url,
               endpoint,
               headers,
               stdio_servers_json,
               client_name,
               version,
               request_timeout_seconds,
               remark
        FROM bedrock_ai_mcp
        WHERE id = #{id}
          AND is_deleted = 0
    </select>

    <select id="selectAiMcpList" resultType="org.bedrock.ai.vo.AiMcpListVO">
        SELECT id,
               name,
               type,
               url,
               status,
               remark
        FROM bedrock_ai_mcp
        WHERE is_deleted = 0
        <if test="param.name != null and param.name != ''">
            AND name LIKE concat('%', #{param.name}, '%')
        </if>
        <if test="param.type != null">
            AND type = #{param.type}
        </if>
        <if test="param.status != null">
            AND status = #{param.status}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>
