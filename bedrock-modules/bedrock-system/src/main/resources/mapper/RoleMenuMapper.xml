<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.bedrock.system.mapper.RoleMenuMapper">
    <insert id="insertBatch">
        insert into bedrock_role_menu
        (id,role_id,menu_id) values
        <foreach collection="list" item="item" separator=",">
            (#{item.id},#{item.roleId},#{item.menuId})
        </foreach>
    </insert>
    <select id="selectMenuIdsByRoleId" resultType="java.lang.String">
        select menu_id from bedrock_role_menu where role_id = #{roleId}
    </select>
</mapper>