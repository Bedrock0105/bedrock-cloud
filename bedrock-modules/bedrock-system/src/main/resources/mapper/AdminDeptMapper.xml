<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.bedrock.system.mapper.AdminDeptMapper">
    <insert id="insertAdminDeptBatch">
        insert into bedrock_admin_dept (id,admin_id,dept_id) values
        <foreach collection="list" item="item" separator=",">
            (#{item.id},#{item.adminId},#{item.deptId})
        </foreach>
    </insert>
</mapper>